{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "web_app",
            "runtimeExecutable": ".venv/bin/python",
            "runtimeArgs": [
                "-m",
                "accident_reconstruction.web_app",
                "--port",
                "8011"
            ],
            "port": 8011,
            "autoPort": false
        },
        {
            "name": "viewer",
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "-lc",
                "cd frontend && exec npm run dev"
            ],
            "port": 5173
        }
    ]
}
