# Copy this file to `.env` (same folder) and fill in values. `.env` is gitignored
# so your keys never get committed.
#
#   cp .env.example .env
#
# Then restart `npm run dev`.

# --- Basemap under the reconstruction ---
# "schematic" (default) = clean OSM extruded buildings (sharp, free-orbit).
# "tiles" = Google Photorealistic 3D Tiles (needs VITE_GOOGLE_TILES_KEY below).
# A real Gaussian splat (VITE_SPLAT_URL) overrides either when set.
# VITE_BASEMAP=schematic

# --- Google Photorealistic 3D Tiles (the real intersection imagery) ---
# A Maps Platform *API key* (string like AIzaSy...), NOT a service-account JSON.
# Console -> APIs & Services -> Credentials -> Create credentials -> API key.
# Enable "Map Tiles API" and make sure billing is on for the project.
VITE_GOOGLE_TILES_KEY=

# --- Optional: import a real car model (.glb/.gltf) ---
# Put the file under frontend/public/ and point to it. Leave commented to use the
# built-in procedural car.
# VITE_CAR_MODEL_URL=/models/car.glb

# --- Optional: where to load reconstruction.json from ---
# Leave commented to use the bundled sample. Or a static file / the backend API:
# VITE_RECONSTRUCTION_URL=/reconstruction.json
# VITE_RECONSTRUCTION_URL=/api/reconstruction?video=<scene>
