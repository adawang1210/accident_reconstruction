{
    "name": "accident-reconstruction-viewer",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Three.js / R3F viewer that replays the backend's reconstruction.json (data-driven vehicle paths + speed) over a 3D intersection.",
    "scripts": {
        "dev": "vite --port 5173 --strictPort",
        "build": "tsc && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@mkkellogg/gaussian-splats-3d": "^0.4.7",
        "@react-three/drei": "^9.114.0",
        "@react-three/fiber": "^8.17.10",
        "3d-tiles-renderer": "^0.4.28",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "three": "^0.169.0",
        "three-stdlib": "^2.36.1",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.1",
        "@types/three": "^0.169.0",
        "@vitejs/plugin-react": "^4.3.2",
        "typescript": "^5.6.3",
        "vite": "^5.4.9"
    }
}
